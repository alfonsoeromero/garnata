# Makefile for the test programs

# Makefile for the unit tests.
#
#   make -f Makefile.test          builds the test programs into bintest/
#   make -f Makefile.test check    builds and runs them
#
# testCompression writes 300,000 random integers, longs and floats with
# the variable-byte coder, reads them back (also after repositioning the
# file) and checks they round-trip exactly. It runs in a temporary
# directory, because it creates its scratch files in the current one.
#
# The main Makefile runs these tests as part of 'make test'.

# Recipes start with '>' instead of a tab
.RECIPEPREFIX = >

COMP=compression
LIB=lib
OBJTEST=objtest
BIN=bintest
CXX=g++
CXXFLAGS=-g -O2 -pipe -W -Wall -std=c++11

$(shell mkdir -p $(OBJTEST) $(BIN))

all: $(BIN)/testCompression

check: all
> @echo "Unit tests"
> @tmp="$$(mktemp -d "$${TMPDIR:-/tmp}/garnata-unit.XXXXXX")"; \
  if (cd "$$tmp" && "$(CURDIR)/$(BIN)/testCompression" > log 2>&1); then \
    echo "  ok    compression round-trip (variable-byte coder)"; rm -rf "$$tmp"; \
  else \
    echo "  FAIL  compression round-trip (variable-byte coder)"; sed 's/^/        /' "$$tmp/log"; rm -rf "$$tmp"; exit 1; \
  fi

$(BIN)/testCompression: $(OBJTEST)/testCompression.o $(LIB)/libcompress.a
> $(CXX) -o $@ $^

$(OBJTEST)/testCompression.o: $(COMP)/testCompression.cpp
> $(CXX) -c $(CXXFLAGS) -I $(COMP) $< -o $@

$(LIB)/libcompress.a:
> $(MAKE) -f Makefile.compression

clean:
> rm -rf $(OBJTEST) $(BIN)

.PHONY: all check clean
